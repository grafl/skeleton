[submodule "apr"]
	path = external/apr
	url = https://github.com/apache/apr.git
[submodule "external/apr-util"]
	path = external/apr-util
	url = https://github.com/apache/apr-util.git
[submodule "external/expat"]
	path = external/expat
	url = https://github.com/libexpat/libexpat.git
[submodule "external/pcre2"]
	path = external/pcre2
	url = https://github.com/PCRE2Project/pcre2.git
[submodule "external/httpd"]
	path = external/httpd
	url = https://github.com/apache/httpd.git
