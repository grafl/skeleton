ServerRoot "@HTTPD_TEST_ROOT@"
Listen 127.0.0.1:8443
ServerName localhost:8443

LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule dir_module modules/mod_dir.so
LoadModule mime_module modules/mod_mime.so
LoadModule socache_shmcb_module modules/mod_socache_shmcb.so
LoadModule ssl_module modules/mod_ssl.so

LoadFile bin/test1.dll
LoadModule test_module modules/mod_test.so
<Location "/test">
    SetHandler test-handler
</Location>

PidFile logs/test-https-httpd.pid
ErrorLog logs/test-https-error.log
LogLevel warn
ServerTokens Prod
ServerSignature Off

SSLSessionCache "shmcb:logs/ssl-session-cache(512000)"
SSLProtocol -all +TLSv1.2 +TLSv1.3
SSLEngine on
SSLCertificateFile conf/ssl/server.crt
SSLCertificateKeyFile conf/ssl/server.key

TypesConfig conf/mime.types
DirectoryIndex index.html
DocumentRoot "@HTTPD_TEST_ROOT@/test-htdocs"

<Directory />
    AllowOverride None
    Require all denied
</Directory>

<Directory "@HTTPD_TEST_ROOT@/test-htdocs">
    Options None
    AllowOverride None
    Require local
</Directory>
